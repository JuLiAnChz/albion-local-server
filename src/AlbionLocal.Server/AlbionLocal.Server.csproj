    <ProjectReference Include="..\AlbionLocal.Protocol\AlbionLocal.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one NuGet package (ARCHITECTURE.md §5.5), restored offline from the local cache (server/nuget.config). -->
